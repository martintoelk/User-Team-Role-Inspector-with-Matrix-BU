<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Core logic for the "User/Team Role Inspector" XrmToolBox plugin.
    Depends only on Microsoft.Xrm.Sdk (IOrganizationService) - no WinForms, no
    XrmToolBox.Extensibility - so it's usable from a unit test project with a
    fake IOrganizationService.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>UserTeamRoleInspector.Core</AssemblyName>
    <RootNamespace>UserTeamRoleInspector.Core</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.0.0</Version>
    <Company>Martin Tölk</Company>
    <Product>User/Team Role Inspector</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- Provides Microsoft.Xrm.Sdk (IOrganizationService, Entity, QueryExpression, ...). -->
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.*" />
  </ItemGroup>

</Project>
